# Copy to .env and adjust. Every value is optional.

PORT=4000
# Signing key for login tokens. If unset, one is generated and stored in data/.jwt-secret.
JWT_SECRET=
TOKEN_TTL=14d
# Where the SQLite database lives (default: ./data)
DATA_DIR=

# Map tiles. The default Esri World Street Map needs no key and is fine for testing; for
# production, use a provider with an account and API key (Esri/ArcGIS, MapTiler, Stadia, Mapbox).
# Don't point this at tile.openstreetmap.org: OSM's volunteer servers block app traffic.
# Example with a MapTiler key: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
TILE_ATTRIBUTION=Tiles &copy; Esri, HERE, Garmin, &copy; OpenStreetMap contributors

# Road routing (OSRM API). The public demo server is for testing only; run your own
# OSRM or set ROUTING_URL= (empty) to fall back to straight-line estimates.
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=12000
AVG_SPEED_KMH=32

# Tracking rules
# Auto-arrive radius around a stop, in metres
GEOFENCE_M=90
# Minutes after the planned time before a stop counts as late
LATE_GRACE_MIN=10
# Minutes without GPS before a vehicle shows "No signal"
OFFLINE_MIN=3
# Ignore fixes less accurate than this (metres) for geofencing and speeding
MAX_ACCURACY_M=150

# Security
# Staff (admins and dispatchers) must use an authenticator app. Only set false for a local demo.
REQUIRE_STAFF_MFA=true

# Data retention (days). Location history is personal data: keep it no longer than you need.
POSITION_RETENTION_DAYS=180
ALERT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730

# Backups: a verified copy of the database every N hours (0 = off), keeping the newest BACKUP_KEEP.
# Copy the backups folder to separate storage too; a backup on the same disk doesn't survive losing that disk.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=

# Demo data (npm run seed)
SEED_LAT=29.7604
SEED_LNG=-95.3698
SEED_STAFF_PASSWORD=dispatch123
SEED_DRIVER_PASSWORD=driver123
