# Copy to .env and adjust. Every value is optional.

PORT=4000
# Signing key for login tokens. If unset, one is generated and stored in data/.jwt-secret.
JWT_SECRET=
TOKEN_TTL=14d
# Where the SQLite database lives (default: ./data)
DATA_DIR=

# Map tiles. The default OpenStreetMap servers are fine for testing; use a commercial
# tile provider (MapTiler, Stadia, Mapbox…) for production traffic.
TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Road routing (OSRM API). The public demo server is for testing only; run your own
# OSRM or set ROUTING_URL= (empty) to fall back to straight-line estimates.
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=12000
AVG_SPEED_KMH=32

# Tracking rules
# Auto-arrive radius around a stop, in metres
GEOFENCE_M=90
# Minutes after the planned time before a stop counts as late
LATE_GRACE_MIN=10
# Minutes without GPS before a vehicle shows "No signal"
OFFLINE_MIN=3
# Ignore fixes less accurate than this (metres) for geofencing and speeding
MAX_ACCURACY_M=150

# Demo data (npm run seed)
SEED_LAT=29.7604
SEED_LNG=-95.3698
SEED_STAFF_PASSWORD=dispatch123
SEED_DRIVER_PASSWORD=driver123
